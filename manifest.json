{
  "manifest_version": 3,
  "name": "Copy Page as Markdown",
  "version": "0.1.0",
  "description": "Copy any page to your clipboard as Markdown, ready to paste into an LLM. Runs locally.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copy page as Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Copy page as Markdown"
    }
  },
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "offscreen", "clipboardWrite"]
}
